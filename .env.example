# Frontend env vars.
# Copy to .env.local for local dev, or set in Cloudflare Pages env settings for prod.

# --- Default (school deploy) ---
# Leave VITE_ENABLE_AI unset (or false). The app will only generate prompts for
# teachers to paste into Microsoft Copilot — no AI calls from the browser.
VITE_ENABLE_AI=false

# --- Optional (personal / home deploy only) ---
# Set BOTH of the below to enable the "Generate with AI" panel.
# Do NOT enable on a school-facing deployment.
# VITE_ENABLE_AI=true
# VITE_API_BASE=https://adapted-ng-api.your-subdomain.workers.dev
